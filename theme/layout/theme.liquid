<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
      <meta name="msvalidate.01" content="6B123633EFF8F4E88147DC9617A7C476" />
  <link rel="preconnect" href="https://dealshub-search.onrender.com" crossorigin>
  <link rel="dns-prefetch" href="https://dealshub-search.onrender.com">

      {{ 'dealshub-mobile-fixes.css' | asset_url | stylesheet_tag }}
        <meta property="og:image" content="{{ 'stylehub-logo-email.png' | asset_url }}" />

  {%- comment -%} SEO Title — unique per template / page handle {%- endcomment -%}
  {%- if template == 'index' -%}
    <title>StyleHub Miami | Best Deals on Fashion, Beauty & Electronics | Free Shipping</title>
  {%- elsif template contains 'product' and product -%}
    <title>{{ product.title | escape }} | ${{ product.price | money_without_currency }} | StyleHub Miami</title>
  {%- elsif template contains 'collection' -%}
    <title>{{ collection.title | escape }} — Shop Best Deals | StyleHub Miami</title>
  {%- elsif template contains 'article' -%}
    <title>{{ article.title | escape }} | StyleHub Miami Blog</title>
  {%- elsif template contains 'blog' -%}
    <title>StyleHub Blog — Tips, Trends & Smart Shopping Guides | StyleHub Miami</title>
  {%- elsif page.handle == 'about-us' -%}
    <title>About Us — StyleHub Miami | Your Trusted Deal Destination</title>
  {%- elsif page.handle == 'faq' -%}
    <title>FAQ — Frequently Asked Questions | StyleHub Miami</title>
  {%- elsif page.handle == 'contact-us' or page.handle == 'contact' -%}
    <title>Contact Us — Customer Support | StyleHub Miami</title>
  {%- elsif page.handle == 'shipping-policy' -%}
    <title>Shipping Policy — Delivery Info | StyleHub Miami</title>
  {%- elsif page.handle == 'returns-refund-policy' -%}
    <title>Returns & Refund Policy | StyleHub Miami</title>
  {%- elsif page.handle == 'privacy-policy' -%}
    <title>Privacy Policy | StyleHub Miami</title>
  {%- elsif page.handle == 'terms-of-service' -%}
    <title>Terms of Service | StyleHub Miami</title>
  {%- elsif page.handle == 'help-center' -%}
    <title>Help Center — Customer Support | StyleHub Miami</title>
  {%- elsif page.handle == 'tracking' -%}
    <title>Track Your Order | StyleHub Miami</title>
  {%- elsif page.handle == 'deals' -%}
    <title>Today's Best Deals — Up to 70% Off | StyleHub Miami</title>
  {%- elsif page.handle == 'best-sellers' -%}
    <title>Best Sellers — Top Rated Products | StyleHub Miami</title>
  {%- elsif page.handle == 'new-arrivals' -%}
    <title>New Arrivals — Latest Products | StyleHub Miami</title>
  {%- elsif page.handle == 'most-wanted' -%}
    <title>Most Wanted — Trending Now | StyleHub Miami</title>
  {%- elsif page.handle == 'plus' -%}
    <title>StyleHub Plus — Free Shipping & Exclusive Benefits</title>
  {%- elsif page.handle == 'rewards' -%}
    <title>Rewards Program — Earn Points | StyleHub Miami</title>
  {%- else -%}
    <title>{{ page_title | escape }}{% unless page_title contains 'StyleHub' %} | StyleHub Miami{% endunless %}</title>
  {%- endif -%}

  {%- comment -%} SEO Meta Descriptions — unique per template / page handle {%- endcomment -%}
  {%- comment -%} Skip garbage auto-gen descriptions ($, product dumps) AND Spanish descriptions on English site {%- endcomment -%}
  {%- assign _has_custom_desc = false -%}
  {%- if page_description and page_description != blank -%}
    {%- assign _desc_lower = page_description | downcase -%}
    {%- unless page_description contains '$' or page_description contains 'Shop Now' or page_description contains '★' or _desc_lower contains 'explora ' or _desc_lower contains 'descubr' or _desc_lower contains 'encuentra ' or _desc_lower contains 'selección curada' or _desc_lower contains 'envío rápido' or _desc_lower contains 'stylehubmiami.' -%}
      {%- assign _has_custom_desc = true -%}
    {%- endunless -%}
  {%- endif -%}
  {%- if _has_custom_desc -%}
    <meta name="description" content="{{ page_description | escape }}">
  {%- elsif template == 'index' -%}
    <meta name="description" content="Shop millions of products at the best prices. Fashion, beauty, electronics, shoes & more. Free shipping on $35+. Secure checkout. Fast delivery to all 50 US states.">
  {%- elsif template contains 'collection' and collection -%}
    <meta name="description" content="Shop the best {{ collection.title | escape }} deals at StyleHub Miami. Top brands, great prices, free shipping on $35+. Secure checkout & fast delivery.">
  {%- elsif page.handle == 'about-us' -%}
    <meta name="description" content="Learn about StyleHub Miami — your trusted destination for the best deals on fashion, beauty, electronics & more. Based in Miami, FL. Serving all 50 US states.">
  {%- elsif page.handle == 'faq' -%}
    <meta name="description" content="Frequently asked questions about StyleHub Miami. Shipping, returns, order tracking, payments & more. Get answers to your questions.">
  {%- elsif page.handle == 'contact-us' or page.handle == 'contact' -%}
    <meta name="description" content="Contact StyleHub Miami customer support. We're here to help with orders, shipping, returns & more. Email: support@stylehubmiami.com">
  {%- elsif page.handle == 'shipping-policy' -%}
    <meta name="description" content="StyleHub Miami shipping policy. Free shipping on orders over $35. Estimated delivery times, shipping methods & tracking information.">
  {%- elsif page.handle == 'returns-refund-policy' -%}
    <meta name="description" content="StyleHub Miami returns & refund policy. Easy 30-day returns. Free return shipping. Full refund guarantee. Learn how to return or exchange items.">
  {%- elsif page.handle == 'privacy-policy' -%}
    <meta name="description" content="StyleHub Miami privacy policy. How we collect, use, and protect your personal information. Your privacy matters to us.">
  {%- elsif page.handle == 'terms-of-service' -%}
    <meta name="description" content="StyleHub Miami terms of service. Rules and guidelines for using our website and purchasing products.">
  {%- elsif page.handle == 'help-center' -%}
    <meta name="description" content="StyleHub Miami Help Center. Find answers about shipping, returns, tracking orders, account issues & more.">
  {%- elsif page.handle == 'tracking' -%}
    <meta name="description" content="Track your StyleHub Miami order. Enter your order number and email to see real-time delivery status and tracking updates.">
  {%- elsif page.handle == 'deals' -%}
    <meta name="description" content="Today's best deals at StyleHub Miami. Up to 70% off on fashion, beauty, electronics & home. New deals added daily. Free shipping on $35+.">
  {%- elsif page.handle == 'best-sellers' -%}
    <meta name="description" content="Shop StyleHub Miami best sellers. Top rated products loved by thousands of customers. Fashion, beauty, electronics & more.">
  {%- elsif page.handle == 'new-arrivals' -%}
    <meta name="description" content="New arrivals at StyleHub Miami. The latest products in fashion, beauty, electronics & home. Be the first to shop trending items.">
  {%- elsif page.handle == 'most-wanted' -%}
    <meta name="description" content="Most wanted products at StyleHub Miami. Trending deals, viral products & customer favorites across all categories.">
  {%- elsif template contains 'blog' -%}
    <meta name="description" content="StyleHub Blog — tips, trends, and smart shopping guides. Discover the best deals, product reviews, and style inspiration at StyleHub Miami.">
  {%- elsif template contains 'article' and article -%}
    <meta name="description" content="{{ article.content | strip_html | truncate: 155 | escape }}">
  {%- else -%}
    <meta name="description" content="StyleHub Miami — Shop the best deals on fashion, beauty, electronics & more. Free shipping on $35+. Secure checkout. 24/7 support.">
  {%- endif -%}

  <link rel="canonical" href="{{ canonical_url }}">

  {%- comment -%} Open Graph Tags {%- endcomment -%}
  <meta property="og:site_name" content="{{ shop.name }}">
  <meta property="og:type" content="{% if request.page_type == 'product' %}product{% else %}website{% endif %}">
  <meta property="og:title" content="{{ page_title | escape }}">
  {%- if page_description -%}
    <meta property="og:description" content="{{ page_description | escape }}">
  {%- else -%}
    <meta property="og:description" content="Shop the best deals on fashion, beauty, electronics &amp; more at StyleHub Miami.">
  {%- endif -%}
  <meta property="og:url" content="{{ canonical_url }}">
  {%- if page_image -%}
    <meta property="og:image" content="https:{{ page_image | image_url: width: 1200 }}">
  {%- endif -%}

  {%- comment -%} Twitter Card {%- endcomment -%}
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{{ page_title | escape }}">
  {%- if page_description -%}
    <meta name="twitter:description" content="{{ page_description | escape }}">
  {%- endif -%}

  {{ content_for_header }}
  <style>
    :root{--dh-red:#e53e3e;--dh-dark:#1a1a2e;--dh-bg:#f8f8f8;--dh-card:#fff}
    *{margin:0;padding:0;box-sizing:border-box}
    body{font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif;background:var(--dh-bg);color:#333;line-height:1.6}
    a{text-decoration:none;color:inherit}
    img{max-width:100%;height:auto}
    @keyframes shimmer{0%{background-position:200% 0}100%{background-position:-200% 0}}
    .dh-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:16px}
    @media(max-width:768px){.dh-grid{grid-template-columns:repeat(2,1fr);gap:10px}}
    @media(max-width:480px){.dh-grid{grid-template-columns:repeat(2,1fr);gap:8px}.dh-api-card h3{font-size:11px!important}}
  </style>
  {{ 'stylehub-api.js' | asset_url | script_tag }}

  {%- comment -%} JSON-LD Structured Data — Home {%- endcomment -%}
  {%- if template == 'index' -%}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    "name": "StyleHub Miami",
    "url": "https://stylehubmiami.com",
    "description": "Shop millions of products at the best prices. Fashion, beauty, electronics and more from Amazon, AliExpress and trusted sellers.",
    "potentialAction": {
      "@type": "SearchAction",
      "target": {
        "@type": "EntryPoint",
        "urlTemplate": "https://stylehubmiami.com/pages/search-results?q={search_term_string}"
      },
      "query-input": "required name=search_term_string"
    }
  }
  </script>
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    "name": "StyleHub Miami",
    "url": "https://stylehubmiami.com",
    "logo": "{{ 'logo.png' | asset_url }}",
    "contactPoint": {
      "@type": "ContactPoint",
      "contactType": "customer service",
      "email": "support@stylehubmiami.com",
      "url": "https://stylehubmiami.com/pages/contact-us",
      "availableLanguage": "English"
    },
    "address": {
      "@type": "PostalAddress",
      "addressLocality": "Miami",
      "addressRegion": "FL",
      "addressCountry": "US"
    }
  }
  </script>
  {%- endif -%}

  {%- comment -%} JSON-LD Structured Data — Shopify Products {%- endcomment -%}
  {%- if template contains 'product' and product -%}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Product",
    "name": {{ product.title | json }},
    "image": [{{ product.featured_image | image_url: width: 1200 | json }}],
    "description": {{ product.description | strip_html | truncate: 300 | default: product.title | json }},
    "sku": {{ product.selected_or_first_available_variant.sku | default: product.id | json }},
    "brand": {
      "@type": "Brand",
      "name": {{ product.vendor | default: "StyleHub" | json }}
    },
    "offers": {
      "@type": "Offer",
      "url": "{{ canonical_url }}",
      "priceCurrency": "{{ cart.currency.iso_code | default: 'USD' }}",
      "price": "{{ product.selected_or_first_available_variant.price | money_without_currency | remove: ',' }}",
      "availability": "{% if product.available %}https://schema.org/InStock{% else %}https://schema.org/OutOfStock{% endif %}",
      "seller": {
        "@type": "Organization",
        "name": "StyleHub Miami"
      }
    }
  }
  </script>
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://stylehubmiami.com/" },
      {%- if product.collections.size > 0 -%}
      { "@type": "ListItem", "position": 2, "name": {{ product.collections.first.title | json }}, "item": "{{ shop.url }}/collections/{{ product.collections.first.handle }}" },
      { "@type": "ListItem", "position": 3, "name": {{ product.title | truncate: 50 | json }} }
      {%- else -%}
      { "@type": "ListItem", "position": 2, "name": {{ product.title | truncate: 50 | json }} }
      {%- endif -%}
    ]
  }
  </script>
  {%- endif -%}

  {%- comment -%} JSON-LD: Collection Breadcrumbs {%- endcomment -%}
  {%- if template contains 'collection' and collection -%}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://stylehubmiami.com/" },
      { "@type": "ListItem", "position": 2, "name": {{ collection.title | json }} }
    ]
  }
  </script>
  {%- endif -%}

  {%- comment -%} JSON-LD: FAQ Page {%- endcomment -%}
  {%- if page.handle == 'faq' -%}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": []
  }
  </script>
  {%- endif -%}

  {%- comment -%} Google Search Console Verification {%- endcomment -%}
  {%- if settings.google_site_verification and settings.google_site_verification != blank -%}
    <meta name="google-site-verification" content="{{ settings.google_site_verification }}">
  {%- endif -%}

  {%- comment -%} Bing Webmaster Verification {%- endcomment -%}
  {%- if settings.bing_site_verification and settings.bing_site_verification != blank -%}
    <meta name="msvalidate.01" content="{{ settings.bing_site_verification }}">
  {%- endif -%}

  {%- comment -%} SEO: noindex for dynamic search/product shell pages (JS-rendered, not useful for Google) {%- endcomment -%}
  {%- if request.path == '/pages/search-results' or request.path == '/pages/product' -%}
    <meta name="robots" content="noindex, follow">
  {%- endif -%}

  {%- comment -%} StyleHub Plus — Server-side detection via customer tags {%- endcomment -%}
  {%- assign is_plus = false -%}
  {%- if customer -%}
    {%- for tag in customer.tags -%}
      {%- if tag == 'plus' -%}
        {%- assign is_plus = true -%}
      {%- endif -%}
    {%- endfor -%}
  {%- endif -%}
  <script>
    window.STYLEHUB_PLUS = {{ is_plus | json }};
    window.STYLEHUB_CUSTOMER = {{ customer.id | default: 'null' }};
    window.STYLEHUB_CUSTOMER_EMAIL = {{ customer.email | default: 'null' | json }};
    {% if is_plus %}
      try { localStorage.setItem('stylehub_plus', 'true'); } catch(e) {}
    {% elsif customer %}
      try { localStorage.removeItem('stylehub_plus'); } catch(e) {}
    {% endif %}
  </script>
</head>
<body>
  {% section 'header' %}
  <main>{{ content_for_layout }}</main>
  {% section 'dealshub-trust-section' %}
  {% section 'dealshub-footer' %}
  <script src="{{ 'dealshub-analytics.js' | asset_url }}" defer></script>
  {% render 'cookie-consent' %}
  <script src="{{ 'dealshub-mobile-fixes.js' | asset_url }}" defer></script>
</body>
</html>
