# DealsHub — Environment Variables
# Copy this to .env and fill in your values

# Shopify Store
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_ADMIN_TOKEN=shpat_xxxxxxxxxxxxxxxxxxxxx
SHOPIFY_LOCATION_ID=84042121347

# RapidAPI
RAPIDAPI_KEY=your-rapidapi-key

# Seal Subscriptions API
SEAL_API_TOKEN=seal_token_xxxxxxxxxxxxxxxxxxxxx
SEAL_API_SECRET=seal_secret_xxxxxxxxxxxxxxxxxxxxx

# Server
PORT=3000
NODE_ENV=production

# ── AutoDS CSV mailer (stop-gap until API is unlocked) ──────────
# Set MAILER_ENABLED=true to actually send. When false the mailer
# logs a dry-run line but does not hit SMTP.
MAILER_ENABLED=true
SMTP_HOST=smtp.zoho.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=noreply@stylehubmiami.com
SMTP_PASS=your-zoho-app-password
MAIL_FROM_NAME=StyleHub Miami
MAIL_FROM_ADDRESS=noreply@stylehubmiami.com

# Where per-order AutoDS CSVs are delivered
AUTODS_CSV_EMAIL_TO=commercecargollc@gmail.com
AUTODS_WAREHOUSE_REGION=US
